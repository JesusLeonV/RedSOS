<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Título de la app -->
            <TextView
                android:id="@+id/tituloApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RED SOS"
                android:textColor="@color/status_red"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"/>

            <!-- Etiqueta de Ubicación -->
            <TextView
                android:id="@+id/ubi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UBICACIÓN ACTUAL"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tituloApp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="20dp"/>

            <!-- Tarjeta del Mapa -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapa"
                android:layout_width="0dp"
                android:layout_height="200dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/neutral_border"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/ubi"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="10dp">

                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapViewHome"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Texto coordenadas -->
            <TextView
                android:id="@+id/coordenadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-18.4783, -70.3126"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/cardMapa"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>

            <!-- Texto de Pregunta de Estado -->
            <TextView
                android:id="@+id/estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿TE ENCUENTRAS BIEN?"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/coordenadas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp"/>

            <!-- Botón Pedir Ayuda (rojo de emergencia) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnayuda"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:text="🚨 PEDIR AYUDA"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/status_red"
                app:layout_constraintTop_toBottomOf="@id/estado"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"/>

            <!-- Botón Estoy Bien (verde de seguridad) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnbn"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:text="✅ ESTOY BIEN"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/status_green"
                app:layout_constraintTop_toBottomOf="@id/btnayuda"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"/>

            <!-- ===== NAVEGACIÓN A OTRAS PANTALLAS ===== -->
            <TextView
                android:id="@+id/tituloNav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAVEGACIÓN"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.15"
                app:layout_constraintTop_toBottomOf="@id/btnbn"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="24dp"/>

            <!-- Fila 1: Información + Mapa -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/navInformacion"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="👤 Mi perfil"
                android:textColor="@color/neutral_dark"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/neutral_border"
                app:layout_constraintTop_toBottomOf="@id/tituloNav"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/navMapa"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navMapa"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="🗺️ Mapa"
                android:textColor="@color/neutral_dark"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/neutral_border"
                app:layout_constraintTop_toBottomOf="@id/tituloNav"
                app:layout_constraintStart_toEndOf="@id/navInformacion"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"
                android:layout_marginStart="8dp"/>

            <!-- Fila 2: Contactos + Auxilios -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/navContactos"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="👥 Contactos"
                android:textColor="@color/neutral_dark"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/neutral_border"
                app:layout_constraintTop_toBottomOf="@id/navInformacion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/navAuxilios"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navAuxilios"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="🩹 Auxilios"
                android:textColor="@color/neutral_dark"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/neutral_border"
                app:layout_constraintTop_toBottomOf="@id/navMapa"
                app:layout_constraintStart_toEndOf="@id/navContactos"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="16dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
