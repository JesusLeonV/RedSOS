<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_light"
    tools:context=".mapa">

    <!-- Barra de filtros (scroll horizontal: los chips se deslizan con el dedo) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chipsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="56dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scrollbars="none"
            android:fadeScrollbars="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAlbergues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏫 Albergues"
                    android:checkable="true"
                    android:checked="true"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPeligro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Peligro"
                    android:checkable="true"
                    android:checked="true"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAgua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚰 Agua"
                    android:checkable="true"
                    android:checked="true"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAyuda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🆘 Ayuda"
                    android:checkable="true"
                    android:checked="true"/>

            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Mapa cuadrado centrado con marco visible (fondo solo se ve en el editor,
         al ejecutar Google Maps dibuja encima) -->
    <FrameLayout
        android:id="@+id/mapMarco"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/chipsCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="#D0DCE8"
        android:elevation="4dp">

        <!-- MapView real de Google Maps -->
        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView2"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Botón flotante: Reportar incidente -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabReportar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reportar incidente"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_dialog_alert"
        app:iconTint="@color/white"
        app:backgroundTint="@color/status_red"
        app:layout_constraintBottom_toTopOf="@id/fabMiUbicacion"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"/>

    <!-- Botón flotante: Mi ubicación -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMiUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Centrar en mi ubicación"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="@color/white"
        app:tint="@color/neutral_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
