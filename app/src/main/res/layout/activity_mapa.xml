<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".mapa">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolver"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="← Volver"
        android:textColor="@color/neutral_dark"
        android:textSize="14sp"
        app:cornerRadius="22dp"
        app:strokeColor="@color/neutral_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:elevation="6dp"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chipsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/btnVolver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:elevation="6dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAlbergues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:checkable="true"
                    android:checked="true"
                    android:textColor="@color/neutral_dark"
                    android:text="🏫 Albergues" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPeligro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Peligro"
                    android:checkable="true"
                    android:checked="true"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAgua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚰 Agua"
                    android:checkable="true"
                    android:checked="true"
                    android:textColor="@color/neutral_dark"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAyuda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🆘 Ayuda"
                    android:checkable="true"
                    android:checked="true"
                    android:textColor="@color/neutral_dark"/>
            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- SupportMapFragment reemplaza al MapView -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/chipsCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMiUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Centrar en mi ubicación"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="@color/white"
        app:tint="@color/neutral_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabReportar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reportar"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/status_red"
        app:icon="@android:drawable/ic_dialog_alert"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fabMiUbicacion"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
