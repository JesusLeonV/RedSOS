<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RedSOS" parent="Theme.Material3.Light.NoActionBar">
        <!-- Impide que Android oscurezca los layouts (causaba texto oscuro sobre fondo oscuro) -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/neutral_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/white</item>
    </style>

    <style name="Theme.RedSOS" parent="Base.Theme.RedSOS" />
</resources>